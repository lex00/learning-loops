---
// The runtime comparison table, generated from the scene manifest so it can never drift from the scene.
const manifests = import.meta.glob('../../scenes/*/manifest.json', { eager: true, import: 'default' });
const { scene } = Astro.props;
const m = manifests[`../../scenes/${scene}/manifest.json`];
const keys = m.variantOrder;
// rows come from the manifest as [label, path]: the path walks the variant, a variant's schedule key expands to its schedule,
// and "|fallback" after the path fills in when the value is missing
const get = (v, path) => {
  const [p, fallback = ''] = path.split('|');
  const ctx = { ...v, schedule: m.schedules ? m.schedules[v.schedule] : v.schedule };
  const val = p.split('.').reduce((o, k) => (o == null ? undefined : o[k]), ctx);
  return val == null || val === '' ? fallback : String(val);
};
---
<table>
  <thead><tr><th></th>{keys.map(k => <th>{m.variants[k].label}</th>)}</tr></thead>
  <tbody>{m.table.map(([label, path]) => <tr><td><strong>{label}</strong></td>{keys.map(k => <td>{get(m.variants[k], path)}</td>)}</tr>)}</tbody>
</table>
